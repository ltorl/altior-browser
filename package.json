{
  "name": "@itsnotme5218/altior-browser",
  "version": "2.0.0",
  "description": "A self-hosted proxy browser with a tabbed web interface",
  "type": "module",
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "node src/index.js",
    "prepublishOnly": "node --check src/index.js"
  },
  "bin": {
    "altior-browser": "./bin/altior-browser.js"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "altior",
    "browser",
    "web-proxy",
    "scramjet",
    "ultraviolet"
  ],
  "author": "letrol & ItsNotme5218",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ItsNotme5218/altior-browser.git"
  },
  "homepage": "https://github.com/ItsNotme5218/altior-browser#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fastify/static": "^9.0.0",
    "@mercuryworkshop/bare-mux": "^2.1.9",
    "@mercuryworkshop/libcurl-transport": "^1.5.2",
    "@mercuryworkshop/scramjet": "https://github.com/MercuryWorkshop/scramjet/releases/download/v1.1.0/mercuryworkshop-scramjet-1.1.0.tgz",
    "@mercuryworkshop/wisp-js": "^0.4.1",
    "@titaniumnetwork-dev/ultraviolet": "^3.2.10",
    "fastify": "^5.7.4",
    "ws": "^8.18.3"
  },
  "packageManager": "pnpm@10.18.3"
}
